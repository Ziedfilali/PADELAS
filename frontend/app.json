{
  "expo": {
    "name": "FIP Padel Analytics",
    "slug": "fip-padel-analytics",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#07090F",
    "scheme": "fip-padel",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fip.padel.analytics"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#07090F"
      },
      "package": "com.fip.padel.analytics"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#07090F",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
