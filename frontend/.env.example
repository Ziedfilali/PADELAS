# Dev (`npx expo start`): point at model-service (see `.env.development`).
# Docker production build uses empty string for same-origin `/api` via nginx.
# Padel API token is configured only on model-service (PADEL_API_TOKEN) — the app calls `/api/padel/month-schedule`.
EXPO_PUBLIC_API_BASE=http://localhost:8000
EXPO_PUBLIC_AZURE_TENANT_ID=
EXPO_PUBLIC_AZURE_CLIENT_ID=
EXPO_PUBLIC_AZURE_REDIRECT_URI=http://localhost:8088
EXPO_PUBLIC_POWERBI_WORKSPACE_ID=
EXPO_PUBLIC_POWERBI_REPORT_ID=
# Optional alternative to workspace/report ids:
EXPO_PUBLIC_POWERBI_EMBED_URL=
