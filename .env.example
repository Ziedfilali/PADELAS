# Copy to .env and adjust. Docker Compose reads variables from .env when present.

# --- SQL Server data warehouse (model-service analytics & training reads)
# From Docker on Windows, DB_HOST is usually host.docker.internal (see docker-compose extra_hosts).
# Enable TCP/IP on SQL Server, default port 1433; allow SQL authentication in SSMS.
# DB_DRIVER=ODBC Driver 18 for SQL Server
# DB_HOST=host.docker.internal
# DB_PORT=1433
# DB_NAME=DW_padel
# DB_USER=your_sql_login
# DB_PASSWORD=your_sql_password
# DB_TRUST_CERT=yes
# When true (default), API falls back to CSV under ./data if SQL is down. Set false after DW works.
# DW_FALLBACK_TO_CSV=true

# Padel API (https://padelapi.org/docs) — live / scheduled matches for the current month
# PADEL_API_TOKEN=
# PADEL_API_BASE=https://padelapi.org/api

# JWT signing key for API auth (model-service /api/auth/*)
JWT_SECRET=dev-secret-change-in-production

# PADELAS HERO (POST /api/padelas-hero/chat) — free Groq key OR local Ollama
# GROQ_API_KEY=           # https://console.groq.com/keys (free tier)
# GROQ_MODEL=llama-3.1-8b-instant
# OLLAMA_BASE_URL=       # e.g. http://host.docker.internal:11434 when Ollama runs on the host
# OLLAMA_MODEL=llama3.2

# Auto-retrain when training CSV files under DATA_DIR change (checksum poll in model-service)
# AUTO_RETRAIN_ENABLED=true
# AUTO_RETRAIN_INTERVAL_SECONDS=60

# Grafana / Prometheus baseline gauges (model-service) for accuracy & confidence alerts
# MONITORING_BASELINE_ACCURACY=0.95
# MONITORING_BASELINE_CONFIDENCE_MEAN=0.85

# Optional: override Power BI embed URL for model-service (defaults match frontend)
# POWERBI_EMBED_URL=https://app.powerbi.com/reportEmbed?reportId=...
